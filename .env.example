# ==============================================================================
# Ops Assistant Service - Environment Configuration Template
# ==============================================================================

# Database Configuration (SQLite local or PostgreSQL)
DATABASE_URL=sqlite+aiosqlite:///./ops_assistant.db
# DATABASE_URL=postgresql+psycopg://postgres:your_password@localhost:5432/ops_assistant

# AI Model Provider (Google Gemini)
GEMINI_API_KEY=your_gemini_api_key_here
MODEL_NAME=gemini-1.5-flash
MODEL_TIMEOUT_SECONDS=30.0
MODEL_MAX_RETRIES=1

# Model Pricing ($ per 1,000 tokens for cost estimation)
COST_PER_1K_INPUT_TOKENS=0.00015
COST_PER_1K_OUTPUT_TOKENS=0.00060

# Redis Rate Limiting (Optional stretch feature - leave empty to disable)
REDIS_URL=redis://localhost:6379/0
RATE_LIMIT_REQUESTS=30
RATE_LIMIT_WINDOW_SECONDS=60

# JWT Authentication
JWT_SECRET_KEY=change-this-to-a-secure-random-secret-in-production
JWT_ALGORITHM=HS256

# App Settings
APP_NAME=Ops Assistant Service
LOG_LEVEL=INFO
